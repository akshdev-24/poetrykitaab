---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icons from '../../components/Icons.astro';
import { getAllPosts } from '../../utils/contentLoader';
import { siteConfig } from '../../config/siteConfig';

const allPosts = getAllPosts();
const breadcrumbs = [{ name: 'Search Archive', url: '/search/' }];
---

<BaseLayout
  meta={{
    title: `Search Archive — ${siteConfig.name}`,
    description: 'Search our literary archive of poems, shayari, nazms, quotes, and reflections by keyword, feeling, or author.',
    noindex: true
  }}
  breadcrumbs={breadcrumbs}
  canonicalPath="/search/"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-14 space-y-8">
    
    <Breadcrumbs items={breadcrumbs} />

    <!-- Search Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <span class="text-xs font-serif uppercase tracking-widest text-[#883025] dark:text-[#c4584b] font-semibold">
        The Archive Index
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-normal text-[#1c1917] dark:text-[#f2eee8]">
        Search PoetryKitaab
      </h1>
      <p class="text-xs sm:text-sm text-[#5e5750] dark:text-[#aba397]">
        Search through our repository of poems, couplets, nazms, and thoughts.
      </p>

      <!-- Search Input Box -->
      <div class="pt-3">
        <div class="relative flex items-center bg-white dark:bg-[#1a1815] rounded-xl border border-[#ded7c8] dark:border-[#2d2a24] shadow-xs focus-within:border-[#883025] p-2 transition-all">
          <div class="pl-3 text-[#7d746c]">
            <Icons name="search" class="w-4 h-4 text-[#883025] dark:text-[#c4584b]" />
          </div>
          <input
            id="search-input"
            type="search"
            placeholder="Search words, verses, emotions (e.g. khamoshi, love, night, silence)..."
            class="w-full px-3 py-2 text-xs sm:text-sm bg-transparent text-[#1c1917] dark:text-[#f2eee8] placeholder-[#a1978d] focus:outline-none"
            autocomplete="off"
            autofocus
          />
          <button
            id="clear-btn"
            type="button"
            class="hidden px-3 text-[#7d746c] hover:text-[#1c1917] dark:hover:text-white"
            aria-label="Clear search"
          >
            <Icons name="x" class="w-4 h-4" />
          </button>
        </div>
      </div>

      <!-- Quick Mood Tags for Fast Search Discovery -->
      <div class="pt-3 flex flex-wrap items-center justify-center gap-1.5">
        <span class="text-[11px] text-[#7d746c] font-serif italic mr-1">Popular searches:</span>
        {siteConfig.moods.map((m) => (
          <button
            type="button"
            class="quick-search-pill text-xs px-2.5 py-1 rounded border border-[#e4ded3] dark:border-[#282520] bg-white dark:bg-[#1a1815] text-[#5e5750] dark:text-[#c7bfb6] hover:border-[#883025] hover:text-[#883025] transition-colors"
            data-query={m.tag}
          >
            {m.title}
          </button>
        ))}
      </div>
    </div>

    <!-- Search Status Bar -->
    <div class="flex items-center justify-between pb-3 border-b border-[#e8e3d8] dark:border-[#2d2a24] text-xs text-[#7d746c] dark:text-[#948c82]">
      <span id="search-count" class="font-serif italic">Showing all {allPosts.length} pieces in archive</span>
    </div>

    <!-- Search Results Grid -->
    <div id="results-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allPosts.map((post) => (
        <article 
          class="post-item group flex flex-col justify-between p-6 rounded-xl border border-[#e4ded3] dark:border-[#282520] bg-white dark:bg-[#1a1815] hover:border-[#883025] dark:hover:border-[#c4584b] transition-all shadow-2xs"
          data-title={post.title.toLowerCase()}
          data-text={post.text.toLowerCase()}
          data-category={post.category.toLowerCase()}
          data-tags={post.tags.join(' ').toLowerCase()}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between text-[11px] text-[#7d746c]">
              <span class="font-semibold text-[#883025] dark:text-[#c4584b] uppercase tracking-wider">
                {post.categoryName || post.category}
              </span>
              <span class="font-serif italic">{post.formattedDate}</span>
            </div>

            <a href={`/${post.category}/${post.slug}`} class="block group/link">
              <p class="font-serif text-lg text-[#1c1917] dark:text-[#f2eee8] leading-[1.8] group-hover/link:text-[#883025] dark:group-hover/link:text-[#c4584b] transition-colors whitespace-pre-line">
                {post.text}
              </p>
            </a>
          </div>

          <div class="pt-4 mt-4 border-t border-[#f4efe6] dark:border-[#23201c] flex items-center justify-between text-xs text-[#7d746c]">
            <span class="font-serif italic text-[11px]">— {post.attribution || 'PoetryKitaab'}</span>
            <a 
              href={`/${post.category}/${post.slug}`}
              class="inline-flex items-center gap-1 font-medium text-[#883025] dark:text-[#c4584b] hover:underline"
            >
              <span>Read piece</span>
              <Icons name="arrow-right" class="w-3 h-3" />
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty Results Fallback -->
    <div id="no-results" class="hidden py-16 text-center max-w-md mx-auto space-y-3">
      <h3 class="font-serif text-xl font-normal text-[#1c1917] dark:text-[#f2eee8]">
        No matching verses found
      </h3>
      <p class="text-xs text-[#7d746c] dark:text-[#948c82]">
        We couldn't find any piece matching your query. Try searching with other words like "love", "night", or "silence".
      </p>
    </div>

  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('clear-btn');
    const items = document.querySelectorAll('.post-item');
    const countEl = document.getElementById('search-count');
    const noResults = document.getElementById('no-results');
    const totalCount = items.length;

    function performSearch(query: string) {
      const q = query.trim().toLowerCase();
      let matchCount = 0;

      if (!q) {
        items.forEach(el => (el as HTMLElement).style.display = '');
        if (noResults) noResults.classList.add('hidden');
        if (countEl) countEl.textContent = `Showing all ${totalCount} pieces in archive`;
        if (clearBtn) clearBtn.classList.add('hidden');
        return;
      }

      if (clearBtn) clearBtn.classList.remove('hidden');

      items.forEach((item) => {
        const title = (item as HTMLElement).dataset.title || '';
        const text = (item as HTMLElement).dataset.text || '';
        const cat = (item as HTMLElement).dataset.category || '';
        const tags = (item as HTMLElement).dataset.tags || '';

        const matches = title.includes(q) || text.includes(q) || cat.includes(q) || tags.includes(q);
        if (matches) {
          (item as HTMLElement).style.display = '';
          matchCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });

      if (countEl) {
        countEl.textContent = `Found ${matchCount} ${matchCount === 1 ? 'piece' : 'pieces'} for "${q}"`;
      }

      if (noResults) {
        if (matchCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    // Read initial URL query param (?q=...)
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || '';
    if (initialQuery && input) {
      input.value = initialQuery;
      performSearch(initialQuery);
    }

    // Input event
    input?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      performSearch(val);
      const newUrl = new URL(window.location.href);
      if (val.trim()) {
        newUrl.searchParams.set('q', val.trim());
      } else {
        newUrl.searchParams.delete('q');
      }
      window.history.replaceState({}, '', newUrl.toString());
    });

    // Clear event
    clearBtn?.addEventListener('click', () => {
      if (input) {
        input.value = '';
        input.focus();
        performSearch('');
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.delete('q');
        window.history.replaceState({}, '', newUrl.toString());
      }
    });

    // Quick search pills
    document.querySelectorAll('.quick-search-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const q = (pill as HTMLElement).dataset.query || '';
        if (input) {
          input.value = q;
          performSearch(q);
          const newUrl = new URL(window.location.href);
          newUrl.searchParams.set('q', q);
          window.history.replaceState({}, '', newUrl.toString());
        }
      });
    });
  });
</script>
