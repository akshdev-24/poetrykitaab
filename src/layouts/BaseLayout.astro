---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/siteConfig';
import { getAbsoluteUrl, formatTitle, getWebsiteSchema, getOrganizationSchema, getBreadcrumbSchema, getPostSchema } from '../utils/seo';

// Determine language for the page (default Hindi for Hindi content, English otherwise)




import type { Post, BreadcrumbItem, SiteMeta } from '../types/content';

interface Props {
  meta?: SiteMeta;
  post?: Post;
  breadcrumbs?: BreadcrumbItem[];
  canonicalPath?: string;
}

const { meta = {}, post, breadcrumbs, canonicalPath } = Astro.props;
// Determine language for the page (default Hindi for Hindi content, English otherwise)
const pageLanguage = meta.language
  ? meta.language
  : post && post.category && ['poetry','shayari','quotes','status','sad','love','life','motivation','attitude','heartbreak'].includes(post.category)
    ? 'hi'
    : 'en';
const ogLocale = pageLanguage === 'en' ? 'en_US' : 'hi_IN';
const currentPath = canonicalPath || Astro.url.pathname;
const canonicalUrl = getAbsoluteUrl(currentPath);

const pageTitle = formatTitle(meta.title);
const pageDescription = meta.description || siteConfig.description;
const ogImage = meta.ogImage 
  ? (meta.ogImage.startsWith('http') ? meta.ogImage : getAbsoluteUrl(meta.ogImage))
  : getAbsoluteUrl('/og-image.svg');
const ogType = meta.ogType || (post ? 'article' : 'website');

// JSON-LD Schemas
const websiteSchema = getWebsiteSchema(pageLanguage === 'en' ? 'en-US' : 'hi-IN');
const breadcrumbSchema = breadcrumbs ? getBreadcrumbSchema(breadcrumbs) : null;
const postSchema = post ? getPostSchema(post) : null;
---

<!doctype html>
<html lang={pageLanguage === 'en' ? 'en-US' : 'hi-IN'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Core SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {meta.noindex && <meta name="robots" content="noindex, follow" />}
    {meta.keywords && <meta name="keywords" content={meta.keywords.join(', ')} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={ogLocale} />
    
    <!-- Organization Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(getOrganizationSchema())} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts Preconnect: Editorial Serif + Hindi Serif + Clean Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Noto+Serif+Devanagari:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" 
      rel="stylesheet" 
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {postSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(postSchema)} />
    )}

    <!-- Inline script to prevent theme flash -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="bg-[#faf7f2] dark:bg-[#131210] text-[#1c1917] dark:text-[#f2eee8] min-h-screen flex flex-col font-sans selection:bg-[#883025]/15 selection:text-[#883025] dark:selection:bg-[#883025]/30 dark:selection:text-[#f7d6d3]">
    <Header currentPath={currentPath} />
    
    <main class="flex-1 w-full">
      <slot />
    </main>

    <Footer />
  </body>
</html>
