---
import { siteConfig } from '../config/siteConfig';
import Icons from './Icons.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Poetry', href: '/poetry/' },
  { name: 'Shayari', href: '/shayari/' },
  { name: 'Quotes', href: '/quotes/' },
  { name: 'Love & Ishq', href: '/love/' },
  { name: 'Sad & Dard', href: '/sad/' },
  { name: 'Life', href: '/life/' },
  { name: 'About', href: '/about/' }
];
---

<header class="sticky top-0 z-40 w-full border-b border-[#e8e3d8] dark:border-[#2d2a24] bg-[#faf7f2]/95 dark:bg-[#131210]/95 backdrop-blur-md transition-colors">
  
  <!-- Subtle Top Journal Bar -->
  <div class="border-b border-[#ede8dd] dark:border-[#23201b] py-1 text-[11px] text-[#7d746c] dark:text-[#948c82] hidden sm:block">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between">
      <span class="italic font-serif">PoetryKitaab • An Open Literary Journal &amp; Archive</span>
      <span class="tracking-wider uppercase text-[10px]">Issue No. 24 — Words for the Unsaid</span>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">
    
    <!-- Brand Wordmark & Emblem -->
    <a href="/" class="flex items-center gap-3 text-[#1c1917] dark:text-[#f2eee8] group">
      <div class="w-8 h-8 rounded-md border border-[#d8d0c2] dark:border-[#38332c] bg-white dark:bg-[#1c1a17] flex items-center justify-center text-[#883025] dark:text-[#c4584b] shadow-2xs group-hover:border-[#883025] transition-colors">
        <!-- Open Kitaab Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
      </div>

      <div class="flex flex-col">
        <span class="font-serif text-2xl sm:text-2xl font-bold tracking-tight leading-tight group-hover:text-[#883025] dark:group-hover:text-[#c4584b] transition-colors">
          PoetryKitaab
        </span>
        <span class="text-[10px] text-[#7d746c] dark:text-[#9c9489] font-sans tracking-widest uppercase -mt-0.5">
          Words &amp; Emotions
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center space-x-6 text-sm font-medium text-[#423d38] dark:text-[#c7bfb6]">
      <a 
        href="/" 
        class={`transition-colors hover:text-[#883025] dark:hover:text-[#f2eee8] ${currentPath === '/' ? 'text-[#883025] dark:text-[#f2eee8] font-semibold underline underline-offset-8 decoration-1 decoration-[#883025]' : ''}`}
      >
        Home
      </a>

      {navLinks.map((link) => {
        const isActive = currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`transition-colors hover:text-[#883025] dark:hover:text-[#f2eee8] ${isActive ? 'text-[#883025] dark:text-[#f2eee8] font-semibold underline underline-offset-8 decoration-1 decoration-[#883025]' : ''}`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Actions: Search Trigger, Theme Switcher, Mobile Toggle -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Search Trigger -->
      <a
        href="/search/"
        class="flex items-center gap-2 px-3.5 py-1.5 text-xs text-[#5e5750] dark:text-[#aba397] hover:text-[#1c1917] dark:hover:text-[#f2eee8] bg-white/80 dark:bg-[#1c1a17] hover:bg-white dark:hover:bg-[#25221e] border border-[#e0d9cc] dark:border-[#2d2a24] rounded-md transition-all shadow-2xs"
        aria-label="Search poems, shayari, and quotes"
      >
        <Icons name="search" class="w-3.5 h-3.5 text-[#883025] dark:text-[#c4584b]" />
        <span class="hidden sm:inline font-sans">Search archive...</span>
      </a>

      <!-- Theme Switcher -->
      <button
        id="theme-toggle"
        type="button"
        class="p-2 rounded-md text-[#5e5750] dark:text-[#aba397] hover:text-[#1c1917] dark:hover:text-[#f2eee8] hover:bg-[#ede7da] dark:hover:bg-[#23201c] transition-colors"
        aria-label="Toggle dark/light reading mode"
      >
        <span class="dark:hidden" title="Switch to lamp reading mode"><Icons name="moon" class="w-4 h-4" /></span>
        <span class="hidden dark:inline" title="Switch to paper reading mode"><Icons name="sun" class="w-4 h-4" /></span>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-md text-[#2c2925] dark:text-[#f2eee8] hover:bg-[#ede7da] dark:hover:bg-[#23201c] transition-colors"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >
        <Icons name="menu" class="w-5 h-5 menu-icon" />
        <Icons name="x" class="w-5 h-5 close-icon hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div 
    id="mobile-menu" 
    class="md:hidden hidden border-t border-[#e8e3d8] dark:border-[#2d2a24] bg-[#faf7f2] dark:bg-[#131210] px-6 py-6 space-y-4"
  >
    <div class="font-serif text-xs text-[#8c847a] uppercase tracking-wider">
      Browse The Kitaab
    </div>
    <div class="grid grid-cols-2 gap-2 text-sm">
      <a href="/" class="p-2.5 rounded-md hover:bg-[#ede7da] dark:hover:bg-[#1e1c18] font-medium">Home</a>
      {siteConfig.categories.map((cat) => (
        <a
          href={`/${cat.slug}/`}
          class="p-2.5 rounded-md hover:bg-[#ede7da] dark:hover:bg-[#1e1c18] flex items-center justify-between"
        >
          <span>{cat.name}</span>
          <span class="text-[11px] text-[#8c847a] font-serif">{cat.hindi}</span>
        </a>
      ))}
    </div>

    <!-- Mood pathways in mobile drawer -->
    <div class="pt-4 border-t border-[#e8e3d8] dark:border-[#2d2a24] space-y-2">
      <span class="text-xs font-serif text-[#883025] dark:text-[#c4584b] italic">Explore By Feeling</span>
      <div class="flex flex-wrap gap-1.5 pt-1">
        {siteConfig.moods.map((m) => (
          <a
            href={`/search/?q=${encodeURIComponent(m.tag)}`}
            class="text-xs px-2.5 py-1 rounded bg-[#ede7da] dark:bg-[#1e1c18] text-[#423d38] dark:text-[#c7bfb6] hover:text-[#883025]"
          >
            {m.title}
          </a>
        ))}
      </div>
    </div>

    <div class="pt-4 border-t border-[#e8e3d8] dark:border-[#2d2a24] flex items-center justify-between text-xs text-[#7d746c] dark:text-[#948c82]">
      <a href="/about/" class="hover:underline">About Kitaab</a>
      <a href="/contact/" class="hover:underline">Contact Editorial</a>
      <a href="/privacy-policy/" class="hover:underline">Privacy</a>
    </div>
  </div>
</header>

<script>
  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = mobileBtn?.querySelector('.menu-icon');
  const closeIcon = mobileBtn?.querySelector('.close-icon');

  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    mobileBtn.setAttribute('aria-expanded', String(isOpen));
    if (isOpen) {
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  });
</script>
