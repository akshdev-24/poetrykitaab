---
import type { BreadcrumbItem } from '../types/content';
import Icons from './Icons.astro';

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`flex items-center text-xs text-stone-500 dark:text-stone-400 py-3 overflow-x-auto whitespace-nowrap ${className}`}>
  <ol class="flex items-center space-x-1.5 sm:space-x-2">
    <li>
      <a href="/" class="hover:text-stone-900 dark:hover:text-white transition-colors">
        Home
      </a>
    </li>

    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center space-x-1.5 sm:space-x-2">
          <Icons name="chevron-right" class="w-3 h-3 text-stone-400" />
          {isLast ? (
            <span class="font-medium text-stone-900 dark:text-stone-200 truncate max-w-[200px] sm:max-w-xs" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-stone-900 dark:hover:text-white transition-colors">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
