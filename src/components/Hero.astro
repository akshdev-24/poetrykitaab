---
import Icons from './Icons.astro';
import CategoryPills from './CategoryPills.astro';
import { siteConfig } from '../config/siteConfig';
---

<section class="relative overflow-hidden bg-stone-900 text-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8">
  <!-- Atmospheric background with warm lighting gradient -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src="/generated/mountain-sunset.svg"
      alt="Scenic peaceful mountain sunset"
      class="w-full h-full object-cover opacity-35 scale-105"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-stone-900 via-stone-900/60 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-stone-900/80 via-transparent to-stone-900/80"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto text-center space-y-6 sm:space-y-8">
    
    <!-- Headline -->
    <div class="space-y-3">
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white drop-shadow-sm">
        Words That <br class="hidden sm:inline" />Feel Like You
      </h1>
      <p class="text-sm sm:text-base md:text-lg text-stone-300 max-w-2xl mx-auto leading-relaxed font-normal">
        {siteConfig.description}
      </p>
    </div>

    <!-- Search Form -->
    <form 
      action="/search/" 
      method="get" 
      class="max-w-xl mx-auto flex items-center bg-white/10 dark:bg-darkSurface-card/90 backdrop-blur-md rounded-full border border-white/20 p-1.5 focus-within:border-amber-400 focus-within:bg-white/20 transition-all shadow-lg"
    >
      <div class="pl-3.5 text-stone-300">
        <Icons name="search" class="w-4 h-4" />
      </div>
      <input
        type="search"
        name="q"
        placeholder="Search quotes, status, category..."
        class="w-full px-3 py-2 text-xs sm:text-sm bg-transparent text-white placeholder-stone-400 focus:outline-none"
        aria-label="Search quotes and status"
        required
      />
      <button
        type="submit"
        class="px-5 py-2 rounded-full bg-amber-600 hover:bg-amber-500 text-stone-950 font-semibold text-xs sm:text-sm transition-colors shadow-sm"
      >
        Search
      </button>
    </form>

    <!-- Quick Category Icons Bar -->
    <div class="pt-2">
      <CategoryPills />
    </div>

  </div>
</section>
