---
import { siteConfig } from '../config/siteConfig';
import Icons from './Icons.astro';

interface Props {
  activeCategory?: string;
  class?: string;
}

const { activeCategory, class: className = '' } = Astro.props;
---

<div class={`w-full overflow-x-auto no-scrollbar py-2 ${className}`}>
  <div class="flex items-center gap-2.5 sm:gap-3 min-w-max pb-1">
    <a
      href="/"
      class={`inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-medium transition-all ${
        !activeCategory
          ? 'bg-stone-900 text-white dark:bg-white dark:text-stone-900 shadow-sm'
          : 'bg-white dark:bg-darkSurface-card text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-darkSurface-border hover:border-stone-400 dark:hover:border-stone-600'
      }`}
    >
      <Icons name="sparkles" class="w-3.5 h-3.5" />
      <span>All Content</span>
    </a>

    {siteConfig.categories.map((cat) => {
      const isActive = activeCategory === cat.slug || activeCategory === cat.id;
      return (
        <a
          href={`/${cat.slug}/`}
          class={`inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-medium transition-all ${
            isActive
              ? 'bg-stone-900 text-white dark:bg-white dark:text-stone-900 shadow-sm'
              : 'bg-white dark:bg-darkSurface-card text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-darkSurface-border hover:border-stone-400 dark:hover:border-stone-600'
          }`}
        >
          <Icons name={cat.icon} class="w-3.5 h-3.5" />
          <span>{cat.name}</span>
        </a>
      );
    })}
  </div>
</div>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
