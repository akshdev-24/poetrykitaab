---
import type { Post } from '../types/content';
import Icons from './Icons.astro';

interface Props {
  post: Post;
  variant?: 'editorial-feature' | 'poetry-stanza' | 'image-feature' | 'archive-row' | 'quote-strip';
  class?: string;
}

const { post, variant = 'poetry-stanza', class: className = '' } = Astro.props;
const postUrl = `/${post.category}/${post.slug}`;

// Format lines of poetry for stanza presentation
const textLines = post.text.split('\n');
---

{variant === 'editorial-feature' && (
  <article class={`group relative p-6 sm:p-10 rounded-xl border border-[#ded7c8] dark:border-[#2d2a24] bg-white dark:bg-[#1a1815] shadow-sm hover:border-[#883025] dark:hover:border-[#c4584b] transition-all ${className}`}>
    <div class="flex items-center justify-between gap-4 pb-4 mb-4 border-b border-[#f0eae0] dark:border-[#26231e] text-xs">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded text-[11px] font-medium uppercase tracking-widest bg-[#883025]/10 text-[#883025] dark:bg-[#c4584b]/15 dark:text-[#f7d6d3]">
          {post.categoryName || post.category}
        </span>
        <span class="text-[#a1978d]">•</span>
        <span class="text-[#7d746c] dark:text-[#948c82] font-serif italic">{post.formattedDate}</span>
      </div>
      <span class="text-[11px] text-[#8c847a] tracking-wider uppercase font-mono">
        {post.readingTime}
      </span>
    </div>

    <div class="space-y-4 max-w-3xl">
      <a href={postUrl} class="block group/link">
        <h3 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-normal text-[#1c1917] dark:text-[#f2eee8] leading-relaxed tracking-tight group-hover/link:text-[#883025] dark:group-hover/link:text-[#c4584b] transition-colors whitespace-pre-line">
          {post.text}
        </h3>
      </a>

      {post.description && (
        <p class="text-xs sm:text-sm text-[#5e5750] dark:text-[#aba397] leading-relaxed pt-2">
          {post.description}
        </p>
      )}
    </div>

    <div class="pt-6 mt-6 border-t border-[#f0eae0] dark:border-[#26231e] flex items-center justify-between text-xs">
      <span class="font-serif italic text-[#7d746c] dark:text-[#948c82]">
        — {post.attribution || 'PoetryKitaab Archive'}
      </span>
      <a
        href={postUrl}
        class="inline-flex items-center gap-1.5 font-medium text-[#883025] dark:text-[#c4584b] hover:underline"
      >
        <span>Read piece</span>
        <Icons name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>
  </article>
)}

{variant === 'poetry-stanza' && (
  <article class={`group flex flex-col justify-between p-6 sm:p-7 rounded-xl border border-[#e4ded3] dark:border-[#282520] bg-white dark:bg-[#1a1815] hover:border-[#883025] dark:hover:border-[#c4584b] transition-all shadow-2xs hover:shadow-sm ${className}`}>
    <div class="space-y-3">
      <div class="flex items-center justify-between text-[11px] text-[#7d746c] dark:text-[#948c82]">
        <span class="font-sans uppercase tracking-widest font-semibold text-[#883025] dark:text-[#c4584b]">
          {post.categoryName || post.category}
        </span>
        <span class="font-serif italic">{post.formattedDate}</span>
      </div>

      <a href={postUrl} class="block group/link pt-1">
        <p class="font-serif text-lg sm:text-xl text-[#1c1917] dark:text-[#f2eee8] leading-[1.85] group-hover/link:text-[#883025] dark:group-hover/link:text-[#c4584b] transition-colors whitespace-pre-line">
          {post.text}
        </p>
      </a>
    </div>

    <div class="pt-5 mt-5 border-t border-[#f4efe6] dark:border-[#23201c] flex items-center justify-between text-xs text-[#7d746c] dark:text-[#948c82]">
      <span class="font-serif italic text-[11px] truncate max-w-[160px]">
        — {post.attribution || 'PoetryKitaab'}
      </span>
      <a 
        href={postUrl}
        class="inline-flex items-center gap-1 font-medium text-[#883025] dark:text-[#c4584b] hover:underline"
        aria-label={`Read ${post.title}`}
      >
        <span>Open</span>
        <Icons name="arrow-right" class="w-3 h-3" />
      </a>
    </div>
  </article>
)}

{variant === 'image-feature' && (
  <article class={`group flex flex-col sm:flex-row gap-5 p-5 sm:p-6 rounded-xl border border-[#e4ded3] dark:border-[#282520] bg-white dark:bg-[#1a1815] hover:border-[#883025] dark:hover:border-[#c4584b] transition-all ${className}`}>
    <a href={postUrl} class="sm:w-2/5 aspect-[4/3] rounded-lg overflow-hidden bg-[#1c1a17] relative flex-shrink-0">
      <img
        src={post.image_path}
        alt={post.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
        onerror="this.onerror=null; this.src='/fallback-quote.svg';"
      />
    </a>

    <div class="flex-1 flex flex-col justify-between space-y-3">
      <div class="space-y-2">
        <div class="flex items-center gap-2 text-[11px] text-[#7d746c] dark:text-[#948c82]">
          <span class="uppercase font-semibold tracking-wider text-[#883025] dark:text-[#c4584b]">
            {post.categoryName || post.category}
          </span>
          <span>•</span>
          <span class="font-serif italic">{post.formattedDate}</span>
        </div>

        <a href={postUrl}>
          <h3 class="font-serif text-lg sm:text-xl text-[#1c1917] dark:text-[#f2eee8] group-hover:text-[#883025] dark:group-hover:text-[#c4584b] transition-colors line-clamp-3 leading-relaxed">
            "{post.text}"
          </h3>
        </a>

        {post.description && (
          <p class="text-xs text-[#5e5750] dark:text-[#a1978d] line-clamp-2">
            {post.description}
          </p>
        )}
      </div>

      <div class="pt-3 border-t border-[#f4efe6] dark:border-[#23201c] flex items-center justify-between text-xs text-[#7d746c] dark:text-[#948c82]">
        <span class="font-serif italic text-[11px]">— {post.attribution || 'PoetryKitaab Archive'}</span>
        <a href={postUrl} class="font-medium text-[#883025] dark:text-[#c4584b] hover:underline flex items-center gap-1">
          <span>Read piece</span>
          <Icons name="arrow-right" class="w-3 h-3" />
        </a>
      </div>
    </div>
  </article>
)}

{variant === 'archive-row' && (
  <article class={`group py-4 px-2 border-b border-[#e8e3d8] dark:border-[#282520] hover:bg-[#f5f0e6]/50 dark:hover:bg-[#181613]/50 transition-colors flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 ${className}`}>
    <div class="space-y-1 sm:max-w-2xl">
      <div class="flex items-center gap-2 text-[11px]">
        <span class="text-[#883025] dark:text-[#c4584b] font-medium uppercase tracking-wider">
          {post.categoryName || post.category}
        </span>
        <span class="text-[#a1978d]">•</span>
        <span class="text-[#7d746c] dark:text-[#948c82] font-serif italic">{post.formattedDate}</span>
      </div>
      <a href={postUrl} class="block">
        <h4 class="font-serif text-base sm:text-lg text-[#1c1917] dark:text-[#f2eee8] group-hover:text-[#883025] dark:group-hover:text-[#c4584b] transition-colors leading-snug">
          "{post.title}"
        </h4>
      </a>
    </div>

    <a href={postUrl} class="text-xs font-serif italic text-[#7d746c] group-hover:text-[#883025] dark:group-hover:text-[#c4584b] flex items-center gap-1 self-start sm:self-auto">
      <span>Read piece</span>
      <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </article>
)}

{variant === 'quote-strip' && (
  <div class={`p-5 rounded-lg border-l-2 border-[#883025] bg-white dark:bg-[#1a1815] shadow-2xs space-y-2 ${className}`}>
    <p class="font-serif text-base italic text-[#1c1917] dark:text-[#f2eee8] leading-relaxed">
      "{post.text}"
    </p>
    <div class="flex items-center justify-between text-xs text-[#7d746c] dark:text-[#948c82] pt-1">
      <span class="font-serif">— {post.attribution || 'PoetryKitaab'}</span>
      <a href={postUrl} class="text-[#883025] dark:text-[#c4584b] hover:underline font-medium">
        Open →
      </a>
    </div>
  </div>
)}
